   "source": [
    "# write a program to convert kilometers to miles\n",
    "\n",
    "kilometers = int(input(\"Enter the distance in kilometres: \"))\n",
    "\n",
    "# Conversion factor = 0.621371\n",
    "\n",
    "convertion_factor = 0.621371\n",
    "\n",
    "miles = kilometers *  convertion_factor\n",
    "\n",
    "print(f\"the {kilometers} kilometers equal to {miles} miles\")"
   ]
