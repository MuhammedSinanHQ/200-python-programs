   "source": [
    "# write a python program for swapping two variables without using a temporary variable\n",
    "\n",
    "a = 5\n",
    "b = 10\n",
    "\n",
    "a, b = b, a\n",
    "\n",
    "# after swapping\n",
    "print(f\"a: {a}\")\n",
    "print(f\"b: {b}\")"
   ]
  }
